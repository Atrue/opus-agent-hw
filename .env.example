# Скопируйте в .env и заполните значениями из Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — ТОЛЬКО для серверных Route Handlers (AI-пайплайн)
SUPABASE_SERVICE_ROLE_KEY=
# AI (OpenRouter): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# CORS: origins через запятную, которым разрешены запросы к /api/*. Пусто = только same-origin.
ALLOWED_ORIGINS=
