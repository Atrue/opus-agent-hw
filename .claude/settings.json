{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx playwright test*)",
      "Bash(npx eslint *)",
      "Bash(git add *)",
      "Bash(git commit*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(npm install *)",
      "Bash(npx playwright install*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Bash(rm -rf *)"
    ]
  },
  "enabledMcpjsonServers": ["chrome-devtools"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/gsd-session-state.sh",
            "timeout": 15,
            "statusMessage": "GSD: инъекция STATE.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-paths.sh",
            "timeout": 10,
            "statusMessage": "Проверка защищённых путей"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/gsd-validate-commit.sh",
            "timeout": 15,
            "statusMessage": "GSD: валидация commit-сообщений"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; case \"$f\" in *.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs) ./node_modules/.bin/eslint --fix \"$f\" 2>/dev/null || true;; esac; }",
            "timeout": 30,
            "statusMessage": "ESLint --fix"
          }
        ]
      }
    ]
  }
}
